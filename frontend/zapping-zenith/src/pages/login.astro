---
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout title="Sign in — Rovingr">
  <section class="auth">
    <div class="wrap">
      <div class="leaf">
        <span class="eyebrow">Welcome back</span>
        <h1>Sign in</h1>
        <div class="ornament" aria-hidden="true"><span>❦</span></div>

        <form id="login-form" novalidate>
          <div class="field">
            <label for="email">Email</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input class="input" id="password" name="password" type="password" autocomplete="current-password" required />
          </div>

          <p class="error" id="form-error" role="alert" hidden></p>

          <button class="btn btn--primary" type="submit">Sign in</button>
        </form>

        <p class="alt">New to Rovingr? <a href="/register">Join Rovingr</a></p>
      </div>
    </div>
  </section>
</PublicLayout>

<script>
  import { api, ApiError } from "../lib/api/client";

  // ASSUMPTION: adjust to your Gin auth route.
  const LOGIN_PATH = "/auth/login";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorEl = document.getElementById("form-error") as HTMLElement;
  const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const data = new FormData(form);
    submit.disabled = true;

    try {
      await api.post(LOGIN_PATH, {
        email: String(data.get("email") ?? "").trim(),
        password: String(data.get("password") ?? ""),
      });
      window.location.href = "/";
    } catch (err) {
      errorEl.textContent =
        err instanceof ApiError ? err.message : "Could not reach Rovingr. Please try again.";
      errorEl.hidden = false;
    } finally {
      submit.disabled = false;
    }
  });
</script>

<style>
  .auth {
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  .leaf {
    display: grid;
    gap: 1.25rem;
    max-width: 28rem;
    margin-inline: auto;
    padding: clamp(1.75rem, 5vw, 2.75rem);
    text-align: center;
    background: #fff;
    border: 2px solid #000;
    box-shadow: 6px 6px 0 #000;
  }

  h1 {
    font-size: 2.6rem;
  }

  form {
    display: grid;
    gap: 1.4rem;
    text-align: left;
  }

  .error {
    padding: 0.5rem 0.75rem;
    font-size: 0.98rem;
    color: var(--accent-d);
    background: rgba(31, 58, 95, 0.08);
    border-left: 3px solid var(--accent);
  }

  .alt {
    font-size: 1rem;
    color: var(--ink-2);
  }
</style>
