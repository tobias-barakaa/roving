---
import "../styles/groups.css";
import DashboardLayout from "./DashboardLayout.astro";
import GroupHeader from "../components/groups/GroupHeader.astro";

interface Props { id: string; active?: string; title?: string; }
const { id, active = "overview", title = "Group" } = Astro.props;
---
<DashboardLayout title={title}>
  <GroupHeader id={id} active={active} />
  <slot />
</DashboardLayout>
