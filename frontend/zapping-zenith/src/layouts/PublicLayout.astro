---
import "../styles/global.css";
import BaseHead from "../components/common/BaseHead.astro";
import TopBar from "../components/navigation/TopBar.astro";
import MainNavigation from "../components/navigation/MainNavigation.astro";

interface Props { title?: string; description?: string; }
const { title = "Rovingr — read together, study together", description } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header><TopBar /><MainNavigation /></header>
    <main id="content"><slot /></main>
    <footer class="footer">
      <div class="wrap footer__inner">
        <a class="footer__brand" href="/">rovingr<span>.</span></a>
        <nav aria-label="Footer">
          <a href="/about">About</a><a href="/community">Community</a><a href="/help">Help</a>
          <a href="/privacy">Privacy</a><a href="/terms">Terms</a>
        </nav>
        <p class="footer__note">© {year} Rovingr</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  main#content { flex: 1; }
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 50; padding: 0.5rem 1rem; background: var(--surface); color: var(--text); border: 1px solid var(--line-strong); }
  .skip:focus { top: 1rem; }
</style>
<style>
  .footer { margin-top: 2rem; border-top: 3px double var(--line-strong); background: var(--surface-2); }
  .footer__inner { display: grid; gap: 0.9rem; justify-items: center; padding-block: 2.25rem; text-align: center; }
  .footer__brand { font-family: var(--font-display); font-size: 1.6rem; line-height: 1; color: var(--accent); text-decoration: none; }
  .footer__brand span { color: var(--secondary); }
  .footer nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.6rem; }
  .footer nav a { font-size: 0.76rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-2); text-decoration: none; }
  .footer nav a:hover { color: var(--accent); text-decoration: underline; }
  .footer__note { font-size: 0.88rem; color: var(--text-3); }
</style>
