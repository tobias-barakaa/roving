---
// Closing "back cover" call-to-action.
---

<section class="closing" aria-labelledby="closing-title">
  <div class="cover">
    <div class="cover__inner">
      <span class="cover__orn" aria-hidden="true">❦</span>
      <h2 id="closing-title">Find your people. Find your rhythm.</h2>
      <p>Learning doesn't have to be a solitary experience.</p>
      <a class="btn btn--cream" href="/register">Become part of Rovingr</a>
    </div>
  </div>
</section>

<style>
  .closing { padding: clamp(0.9rem, 2.5vw, 1.5rem); }

  .cover {
    padding: clamp(0.7rem, 2vw, 1.1rem);
    background:
      repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.04) 0 2px, transparent 2px 8px),
      var(--c-crimson);
    border: 2px solid #000;
  }

  .cover__inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(2.5rem, 7vw, 4.5rem) var(--gutter);
    text-align: center;
    color: #fdf6e3;
    border: 2px solid rgba(253, 246, 227, 0.8);
    outline: 1px solid rgba(253, 246, 227, 0.45);
    outline-offset: 6px;
  }

  .cover__orn { font-size: 1.7rem; color: #f2c14e; }

  h2 {
    max-width: 20ch;
    font-size: clamp(2rem, 1.4rem + 2.8vw, 3.4rem);
    line-height: 1.1;
    color: #fff;
  }

  p { font-size: 1.15rem; opacity: 0.92; }
  .cover :global(.btn) { margin-top: 0.75rem; color: var(--accent-d); }
</style>
