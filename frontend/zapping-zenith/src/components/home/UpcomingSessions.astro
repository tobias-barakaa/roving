---
import SectionHeading from "../common/SectionHeading.astro";

// Placeholder data. Replace with API data once Scheduling endpoints are wired.
const sessions = [
  { title: "Evening study", status: "Scheduled", kind: "Group study", time: "6:30 PM", zone: "Africa/Nairobi" },
  { title: "Mathematics revision", status: "Upcoming", kind: "Group study", time: "8:00 PM", zone: "" },
];
---

<section class="section sessions" aria-labelledby="sessions-title">
  <div class="wrap">
    <SectionHeading
      eyebrow="The timetable"
      title="Upcoming study sessions"
      linkText="View schedule →"
      href="/sessions"
      id="sessions-title"
    />

    <ol class="ledger">
      {
        sessions.map((s) => (
          <li class="entry">
            <div class="entry__time">{s.time}</div>
            <div class="entry__main">
              <h3>{s.title}</h3>
              <p>
                {s.kind}
                {s.zone && <> · {s.zone}</>}
              </p>
            </div>
            <span class="entry__status">{s.status}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .sessions { background: var(--paper-2); border-block: 2px solid #000; }

  .ledger { display: grid; gap: 1rem; max-width: 46rem; margin-inline: auto; }

  .entry {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    align-items: stretch;
    gap: 0;
    background: #fff;
    border: 2px solid #000;
    box-shadow: 4px 4px 0 #000;
  }

  .entry__time {
    display: grid;
    place-items: center;
    padding: 1rem 0.5rem;
    font-size: 1.5rem;
    font-weight: 500;
    color: #fff;
    background: var(--c-navy);
    border-right: 2px solid #000;
  }

  .entry__main { align-self: center; padding: 0.9rem 1.2rem; }
  .entry__main h3 { font-size: 1.4rem; }
  .entry__main p { font-size: 0.98rem; color: var(--ink-2); }

  .entry__status {
    align-self: center;
    margin-right: 1.1rem;
    padding: 0.15rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    background: var(--c-green);
    border: 2px solid #000;
  }

  @media (max-width: 34rem) {
    .entry { grid-template-columns: 1fr auto; }
    .entry__time { grid-column: 1 / -1; border-right: 0; border-bottom: 2px solid #000; padding: 0.5rem; }
  }
</style>
