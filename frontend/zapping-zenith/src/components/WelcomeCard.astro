
---
const title = "Welcome to Rovingr";
const description = "Your space to study, focus and grow together.";
---

<div class="welcome-card">
  <h1>{title}</h1>
  <p>{description}</p>
  <button>Get Started</button>
</div>

<style>
  .welcome-card {
    max-width: 600px;
    margin: 80px auto;
    padding: 40px;
    background: #18181b;
    color: white;
    border-radius: 16px;
    text-align: center;
  }

  h1 {
    font-size: 32px;
    margin-bottom: 12px;
  }

  p {
    color: #a1a1aa;
    margin-bottom: 24px;
  }

  button {
    background: #6366f1;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    cursor: pointer;
  }
</style>
