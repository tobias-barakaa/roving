---
// Month navigation works today. Week and day views are planned, so they are shown as labels, not buttons.
---
<div class="cal__head">
  <h2 class="cal__title" data-cal-title aria-live="polite">Month</h2>
  <p class="cal__views" aria-label="Calendar views"><b>Month</b> · Week (planned) · Day (planned)</p>
  <div class="cal__nav">
    <button class="btn btn--ghost btn--sm" type="button" data-cal-prev aria-label="Previous month">‹</button>
    <button class="btn btn--ghost btn--sm" type="button" data-cal-today>Today</button>
    <button class="btn btn--ghost btn--sm" type="button" data-cal-next aria-label="Next month">›</button>
  </div>
</div>
