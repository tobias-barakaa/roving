---
/**
 * Bottom control bar: camera (host only), microphone, side panel, leave.
 * Sticks to the bottom of the viewport so it stays reachable on mobile.
 * "Leave" is a real link, so it works even if scripts fail; the script stops
 * the camera/mic and the connection first.
 */
interface Props { leaveHref: string; }
const { leaveHref } = Astro.props;
---
<div class="rm-bar" role="toolbar" aria-label="Room controls" data-rm-bar>
  <button class="rm-ctl" type="button" data-rm-bar-cam data-host-only data-state="off" aria-label="Turn on camera">
    <svg aria-hidden="true" class="rm-ctl__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="13" height="12" rx="2"/><path d="m15 10 6-3v10l-6-3z"/><path class="rm-ctl__slash" d="M3 3l18 18"/></svg>
    <span class="rm-ctl__label">Camera</span>
    <span class="rm-ctl__state" aria-hidden="true" data-rm-bar-cam-state>Off</span>
  </button>

  <button class="rm-ctl" type="button" data-rm-bar-mic data-state="off" aria-label="Turn on microphone">
    <svg aria-hidden="true" class="rm-ctl__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/><path class="rm-ctl__slash" d="M3 3l18 18"/></svg>
    <span class="rm-ctl__label">Mic</span>
    <span class="rm-ctl__state" aria-hidden="true" data-rm-bar-mic-state>Off</span>
  </button>

  <button class="rm-ctl" type="button" data-rm-side-toggle aria-controls="rm-side" aria-expanded="true" aria-label="Hide side panel">
    <svg aria-hidden="true" class="rm-ctl__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg>
    <span class="rm-ctl__label">Panel</span>
  </button>

  <a class="rm-ctl rm-ctl--leave" href={leaveHref} data-rm-leave aria-label="Leave room">
    <svg aria-hidden="true" class="rm-ctl__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
    <span class="rm-ctl__label">Leave</span>
  </a>
</div>
