---
/**
 * Title block of the room page: breadcrumb, room name, description, badges.
 * Filled in by src/lib/rooms/roomPage.ts through the data-rm-* hooks.
 */
interface Props { groupHref: string; roomsHref: string; }
const { groupHref, roomsHref } = Astro.props;
---
<header class="rm-head">
  <nav class="rm-crumbs" aria-label="Breadcrumb">
    <a href={groupHref} data-rm-crumb-group>Group</a>
    <span aria-hidden="true">/</span>
    <a href={roomsHref}>Rooms</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page" data-rm-crumb-room>Room</span>
  </nav>
  <div class="rm-head__row">
    <div class="rm-head__text">
      <span class="eyebrow">Study room</span>
      <h1 data-rm-name>Room</h1>
      <p class="rm-head__desc" data-rm-desc hidden></p>
    </div>
    <div class="rm-head__badges" data-rm-badges></div>
  </div>
</header>
