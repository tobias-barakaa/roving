---
// The running head of the book: quiet section links between double rules.
const items = [
  { label: "Study Groups", href: "/dashboard/discover" },
  { label: "Reading", href: "/dashboard/reading" },
  { label: "Sessions", href: "/dashboard/calendar" },
  { label: "Chess", href: "/dashboard/chess" },
  { label: "Community", href: "/dashboard" },
];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<nav class="main-nav" aria-label="Sections">
  <ul class="wrap main-nav__list">
    {items.map((i) => (
      <li>
        <a class:list={["main-nav__link", { "is-active": path === i.href }]} href={i.href}
           aria-current={path === i.href ? "page" : undefined}>{i.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .main-nav { background: var(--bg); border-bottom: 1px solid var(--line); }
  .main-nav__list { display: flex; justify-content: center; gap: clamp(1.1rem, 4vw, 3rem); padding-block: 0.65rem; overflow-x: auto; scrollbar-width: none; }
  .main-nav__list::-webkit-scrollbar { display: none; }
  .main-nav__link {
    display: inline-block; padding-block: 0.2rem; white-space: nowrap; font-size: 0.95rem; font-weight: 600;
    letter-spacing: 0; text-decoration: none; color: var(--text-2);
    border-bottom: 1px solid transparent;
  }
  .main-nav__link:hover, .main-nav__link.is-active { color: var(--accent); border-bottom-color: var(--secondary); }
  @media (max-width: 40rem) { .main-nav__list { justify-content: flex-start; } }
</style>
