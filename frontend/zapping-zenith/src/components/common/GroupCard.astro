---
interface Props {
  title: string;
  kicker: string; // e.g. "Reading · Discussion"
  description?: string;
  href?: string;
  tone?: "crimson" | "green" | "blue" | "purple" | "teal" | "navy";
}

const { title, kicker, description, href = "/groups", tone = "crimson" } = Astro.props;
const monogram = title.replace(/^(the|a|an)\s+/i, "").charAt(0).toUpperCase();
---

<article class="card">
  <a class="card__link" href={href}>
    <div class={`cover cover--${tone}`} aria-hidden="true">
      <div class="cover__frame">
        <span class="cover__mono">{monogram}</span>
        <span class="cover__orn">❦</span>
      </div>
    </div>

    <div class="card__body">
      <p class="card__kicker">{kicker}</p>
      <h3 class="card__title">{title}</h3>
      {description && <p class="card__desc">{description}</p>}
      <span class="card__cta">Join group →</span>
    </div>
  </a>
</article>

<style>
  .card { height: 100%; padding-bottom: 8px; }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    background: #fff;
    border: 2px solid #000;
    /* a little stack of pages under the card */
    box-shadow:
      0 3px 0 -1px #fff, 0 4px 0 -1px #8c95aa,
      0 7px 0 -2px #fff, 0 8px 0 -2px #8c95aa;
    transition: transform 0.12s ease;
  }
  .card__link:hover { transform: translateY(-2px); color: inherit; }
  .card__link:hover .card__cta { text-decoration: underline; }

  .cover {
    --c: var(--c-crimson);
    padding: 0.8rem;
    background:
      repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 8px),
      var(--c);
    border-bottom: 2px solid #000;
  }
  .cover--crimson { --c: var(--c-crimson); }
  .cover--green { --c: var(--c-green); }
  .cover--blue { --c: var(--c-blue); }
  .cover--purple { --c: var(--c-purple); }
  .cover--teal { --c: var(--c-teal); }
  .cover--navy { --c: var(--c-navy); }

  .cover__frame {
    display: grid;
    place-items: center;
    gap: 0.1rem;
    aspect-ratio: 16 / 9;
    color: #fdf6e3;
    border: 2px solid rgba(253, 246, 227, 0.8);
    outline: 1px solid rgba(253, 246, 227, 0.5);
    outline-offset: 4px;
  }
  .cover__mono { font-size: 3.6rem; line-height: 0.95; }
  .cover__orn { font-size: 1.1rem; color: #f2c14e; }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem 1.3rem;
  }
  .card__kicker {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card__title { font-size: 1.55rem; }
  .card__desc { font-size: 1rem; color: var(--ink-2); }
  .card__cta {
    margin-top: auto;
    padding-top: 0.6rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
