---
interface Props {
  title: string;
  author?: string;
  subject: string;
  href?: string;
  tone?: "crimson" | "green" | "blue" | "purple" | "teal" | "navy";
}

const { title, author, subject, href = "/reading", tone = "crimson" } = Astro.props;
---

<a class="book" href={href}>
  <div class={`book__cover book__cover--${tone}`}>
    <span class="book__spine" aria-hidden="true"></span>
    <div class="book__face">
      <span class="book__rule" aria-hidden="true"></span>
      <span class="book__title">{title}</span>
      <span class="book__rule" aria-hidden="true"></span>
      {author && <span class="book__author">{author}</span>}
    </div>
  </div>
  <p class="book__subject">{subject}</p>
</a>

<style>
  .book { display: block; color: inherit; text-decoration: none; }

  .book__cover {
    --c: var(--c-crimson);
    position: relative;
    display: flex;
    aspect-ratio: 2 / 3;
    background:
      repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 8px),
      var(--c);
    border: 2px solid #000;
    /* page block visible on the right-hand edge */
    box-shadow:
      3px 0 0 -1px #fff, 4px 0 0 -1px #8c95aa,
      6px 0 0 -2px #fff, 7px 0 0 -2px #8c95aa,
      0 6px 0 -3px rgba(0, 0, 0, 0.35);
  }
  .book:hover .book__cover { outline: 3px solid #f2c14e; outline-offset: 3px; }

  .book__cover--crimson { --c: var(--c-crimson); }
  .book__cover--green { --c: var(--c-green); }
  .book__cover--blue { --c: var(--c-blue); }
  .book__cover--purple { --c: var(--c-purple); }
  .book__cover--teal { --c: var(--c-teal); }
  .book__cover--navy { --c: var(--c-navy); }

  .book__spine {
    flex: 0 0 11%;
    background:
      linear-gradient(to right, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.1) 70%, rgba(255, 255, 255, 0.1));
    border-right: 2px solid #000;
  }

  .book__face {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin: 0.55rem;
    padding: 0.5rem;
    text-align: center;
    color: #fdf6e3;
    border: 2px solid rgba(253, 246, 227, 0.8);
  }
  .book__title { font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem); line-height: 1.15; }
  .book__rule { width: 55%; height: 2px; background: #f2c14e; }
  .book__author {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .book__subject {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .book:hover .book__subject { color: var(--accent); }
</style>
